<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Swoosh.SettingsApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0"
                       Text="Swoosh"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="190"
                             IsPaneToggleButtonVisible="False"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="general" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Snapping" Tag="snapping">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE744;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Appearance" Tag="appearance">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Updates" Tag="updates">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="About" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel x:Name="SwooshCountPanel" Orientation="Horizontal" Spacing="8"
                            Padding="14,10,14,14" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="-2">
                        <TextBlock x:Name="SwooshCountText" Text="0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SwooshCountLabel" Text="lifetime swooshes"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,12,28,28">
                    <!-- GENERAL -->
                    <StackPanel x:Name="GeneralPane" Spacing="14">
                        <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <!-- Windows-Home-style header: logo, name + link, status chips -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="GeneralLogo" Grid.Column="0" Width="64" Height="64"
                                   Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Swoosh" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Swish-style window snapping for the Precision Touchpad"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Content="View on GitHub" Padding="0,2,0,0" FontSize="12"
                                                 NavigateUri="https://github.com/bwya77/swoosh" />
                            </StackPanel>
                            <StackPanel x:Name="HeaderStats" Grid.Column="2" Orientation="Horizontal" Spacing="22"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE777;" FontSize="20" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock x:Name="HeroUpdateTitle" Text="Swoosh"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="HeroVersion" Text="v0.0.0"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="20" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock x:Name="HeroCountText" Text="0"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="HeroCountLabel" Text="lifetime swooshes"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Grouped card: gestures and animation -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                    <TextBlock Text="Gestures and animation" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="How touchpad gestures behave"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C9;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Gestures enabled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Master switch for all touchpad gestures."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="GesturesToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Animate window snaps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Glide windows into place instead of snapping instantly."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AnimateToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="6" Margin="34,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Snap speed" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <TextBlock Text="How fast windows glide into place. The HUD matches this speed."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fast" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Slider x:Name="SnapSpeedSlider" Grid.Column="1" Margin="12,0"
                                                Minimum="0" Maximum="35" StepFrequency="1"
                                                ValueChanged="OnSnapSpeedChanged" />
                                        <TextBlock Grid.Column="2" Text="Smooth" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Grouped card: startup and troubleshooting -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                    <TextBlock Text="Startup and troubleshooting" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Launch options and diagnostics"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Launch Swoosh automatically when you sign in."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LaunchToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Touchpad demo overlay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Show a polished on-screen touchpad with your live finger movements and the active gesture. Great for screen recordings and demos."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DemoToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Copy a touchpad and system report to your clipboard. Paste it into a GitHub issue if gestures aren't working, so the problem can be diagnosed."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="CopyDiagBtn" Grid.Column="2" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="OnCopyDiagnostics">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="CopyDiagIcon" Glyph="&#xE8C8;" FontSize="14" />
                                            <TextBlock x:Name="CopyDiagText" Text="Copy" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9F5;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Top"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Phantom contact filtering" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Filters out stuck firmware contacts that some touchpads report. Leave this on. Only turn it off if gestures behave erratically on your device, to check whether this filter is the cause."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PhantomToggle" Grid.Column="2" Margin="12,0,0,0"
                                                  VerticalAlignment="Top" Toggled="OnSettingToggled" />
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE897;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Top"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Gesture tutorial" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Replay the quick walkthrough that shows each touchpad gesture and what it does."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="TutorialBtn" Grid.Column="2" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="OnReplayTutorial">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Replay" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE939;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Top"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Report a problem" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Open a pre-filled GitHub issue with your diagnostics attached, so the problem can be looked into."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="ReportBtn" Grid.Column="2" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="OnReportProblem">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE939;" FontSize="14" />
                                            <TextBlock Text="Report" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Height="1" Margin="34,0,0,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="18" Margin="0,0,16,0"
                                              VerticalAlignment="Top"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Restore defaults" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Reset all Swoosh settings to their original values."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RestoreDefaultsBtn" Grid.Column="2" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="OnRestoreDefaults">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="Restore" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SNAPPING -->
                    <StackPanel x:Name="SnappingPane" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Snapping" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2,0,0">
                            <FontIcon Glyph="&#xE7C9;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Gestures"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Gestures" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Click a gesture to turn it on or off."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="GestureHost" Spacing="10" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Modifier key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Which key engages thirds snapping."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ModifierCombo" Grid.Column="2" MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnModifierChanged">
                                    <ComboBoxItem Content="Shift" />
                                    <ComboBoxItem Content="Ctrl" />
                                    <ComboBoxItem Content="Alt" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                            <FontIcon Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Snap behavior"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE921;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Swipe down" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="What a downward swipe does. Choose Let me choose to show a small picker and lean left to minimize or right to close."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="SwipeDownCombo" Grid.Column="2" MinWidth="140"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnSwipeDownChanged">
                                    <ComboBoxItem Content="Minimize" />
                                    <ComboBoxItem Content="Close window" />
                                    <ComboBoxItem Content="Let me choose" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border x:Name="SwipeDownThresholdCard" Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Swipe-down deliberateness" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <TextBlock Text="How far down you must pull before close/minimize engages. Higher means only a long, deliberate swipe triggers it, so other gestures won't."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Light" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="SwipeDownThresholdSlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="28" StepFrequency="1"
                                            ValueChanged="OnSwipeDownThresholdChanged" />
                                    <TextBlock Grid.Column="2" Text="Deliberate" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Touch sensitivity" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <TextBlock Text="Lower values ignore vertical drift during a sideways swipe."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Forgiving" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="SensitivitySlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="1" StepFrequency="0.05"
                                            ValueChanged="OnSensitivityChanged" />
                                    <TextBlock Grid.Column="2" Text="Twitchy" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Grid spacing" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="GridSpacingValue" Grid.Column="1" Text="0 px"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="Gap left around snapped windows, in pixels."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0 px" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="GridSpacingSlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="10" StepFrequency="1"
                                            ValueChanged="OnGridSpacingChanged" />
                                    <TextBlock Grid.Column="2" Text="10 px" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cancel timeout" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="CancelTimeoutValue" Grid.Column="1" Text="0.8 s"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="Cancel a gesture by pressing Esc, or by resting your fingers still for this long (0 = never)."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Off" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="CancelTimeoutSlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="3" StepFrequency="0.1"
                                            ValueChanged="OnCancelTimeoutChanged" />
                                    <TextBlock Grid.Column="2" Text="3 s" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE890;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Live window preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Move the real window to the target zone as you swipe, instead of showing the overlay. Esc puts it back."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LivePreviewToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C2;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Move cursor with window" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="After a snap, move the cursor to the same spot in the window's new position (for example, the middle of the titlebar stays under the cursor)."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MoveCursorToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                            <FontIcon Glyph="&#xE740;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Two-finger resize"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE89F;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Resize width with two fingers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Spread two fingers apart horizontally over a titlebar to grow the window's width, or together to shrink it. While either two-finger resize is on, the two-finger pinch no longer maximizes (swipe up still does)."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ResizeHorizontalToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A0;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Resize height with two fingers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Spread two fingers apart vertically over a titlebar to grow the window's height, or together to shrink it. While either two-finger resize is on, the two-finger pinch no longer maximizes (swipe up still does)."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ResizeVerticalToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Virtual desktops and displays"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Switch apps instead of desktops" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Replaces the hold-and-swipe virtual-desktop move. When on, holding a window then swiping shows your open apps in the HUD; swipe to highlight one and release to focus it so you can work in it, like Alt+Tab driven by the touchpad. Off by default."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AppSwitchOnHoldToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7F8;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Move to display" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Hold the chosen key and swipe to send the window to the next physical monitor. Choose Off to disable it."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="MonitorMoveCombo" Grid.Column="2" MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnMonitorMoveChanged">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Shift" />
                                    <ComboBoxItem Content="Ctrl" />
                                    <ComboBoxItem Content="Alt" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7C4;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Preview destination desktop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="When moving a window to another virtual desktop (hold then swipe), the HUD highlights the desktop it will land on as you aim. Swipe farther to target a further desktop, then drop to send the window there."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PreviewDesktopDestinationToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE710;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Create a new desktop on overflow" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="When you hold then swipe past the last virtual desktop, create a new one and move the window there instead of stopping at the edge. Off by default."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CreateDesktopOverflowToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnSettingToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Desktop switch hold delay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="HoldDelayValue" Grid.Column="1" Text="0.30 s"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="How long you must hold two fingers still before the virtual-desktop switcher engages and its HUD appears."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0.1 s" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="HoldDelaySlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="0.9" StepFrequency="0.05"
                                            ValueChanged="OnHoldDelayChanged" />
                                    <TextBlock Grid.Column="2" Text="1.0 s" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- APPEARANCE -->
                    <StackPanel x:Name="AppearancePane" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2,0,0">
                            <FontIcon Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Highlight color"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Use Windows accent color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Match the snap overlay highlight to your accent color."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OverlayAccentToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="OnAccentToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Overlay color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Pick a preset or choose your own. Used when not following the accent color."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,0">
                            <FontIcon Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Gesture HUD"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="HUD background" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Backdrop for the gesture HUD. Choose Follow system to match the Windows light/dark setting. The highlight color is unchanged."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="HudBackgroundCombo" Grid.Column="2" MinWidth="140"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnHudBackgroundChanged">
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Follow system" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE740;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="HUD size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Size of the gesture HUD on screen. Large renders it bigger than Normal."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="HudSizeCombo" Grid.Column="2" MinWidth="140"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnHudSizeChanged">
                                    <ComboBoxItem Content="Normal" />
                                    <ComboBoxItem Content="Large" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HUD fade-out" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="HudFadeValue" Grid.Column="1" Text="0.36 s"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <TextBlock Text="How long the gesture HUD takes to fade away when a gesture ends. Higher values make it linger and fade more slowly."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0.1 s" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="HudFadeSlider" Grid.Column="1" Margin="12,0"
                                            Minimum="0" Maximum="1.4" StepFrequency="0.05"
                                            ValueChanged="OnHudFadeChanged" />
                                    <TextBlock Grid.Column="2" Text="1.5 s" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- UPDATES -->
                    <StackPanel x:Name="UpdatesPane" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateStatus" Text="Checking for updates..."
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="UpdateSub" Text=""
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="DownloadBtn" Content="Download" Visibility="Collapsed"
                                            Style="{StaticResource AccentButtonStyle}" Click="DownloadBtn_Click" />
                                    <Button x:Name="CheckBtn" Content="Check now" Click="CheckBtn_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4,0,0">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="What's new"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Top"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="See the full list of changes and release notes for every version."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
