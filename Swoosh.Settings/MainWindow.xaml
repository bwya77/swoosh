                                                     NavigateUri="https://github.com/bwya77/swoosh/blob/main/CHANGELOG.md"
                                                     Padding="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ABOUT -->
                    <StackPanel x:Name="AboutPane" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Image x:Name="AppLogo" Width="48" Height="48"
                                           VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="Swoosh" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="VersionText" Text="v0.0.0"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Swish-style window snapping gestures for the Windows Precision Touchpad."
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <HyperlinkButton Content="github.com/bwya77/swoosh"
                                                 NavigateUri="https://github.com/bwya77/swoosh"
                                                 Padding="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE72D;" FontSize="18" Margin="0,0,16,0"
                                          VerticalAlignment="Top"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Share Swoosh" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Enjoying Swoosh? Help others discover it. Share the link or post it to your favorite community."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button x:Name="CopyLinkBtn" Click="OnCopyShareLink">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon x:Name="CopyLinkIcon" Glyph="&#xE8C8;" FontSize="14" />
                                                <TextBlock x:Name="CopyLinkText" Text="Copy link" VerticalAlignment="Center" />
                                            </StackPanel>
