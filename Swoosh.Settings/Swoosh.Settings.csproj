<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Swoosh.SettingsApp</RootNamespace>
    <AssemblyName>Swoosh.Settings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\swoosh.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Self-contained Windows App Runtime bundles an AI/ML runtime we never call;
         the release workflow deletes those native DLLs after publish to trim size. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <!-- Copy the app icon next to the exe so the window can set its title-bar/taskbar
       icon at runtime via AppWindow.SetIcon. -->
  <ItemGroup>
    <Content Include="..\Assets\swoosh.ico" Link="swoosh.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\swoosh-256.png" Link="Assets\swoosh-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Share the settings model, persistence, and update checker with the main app
       by linking the source rather than maintaining a separate library. -->
  <ItemGroup>
    <Compile Include="..\Settings\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\Settings\SettingsStore.cs" Link="Shared\SettingsStore.cs" />
    <Compile Include="..\Settings\SwooshStats.cs" Link="Shared\SwooshStats.cs" />
    <Compile Include="..\Updates\UpdateChecker.cs" Link="Shared\UpdateChecker.cs" />
  </ItemGroup>

</Project>
