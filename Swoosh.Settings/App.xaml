<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Swoosh.SettingsApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <!-- Compact toggles: WinUI's default ToggleSwitch reserves ~154px (the old
                 On/Off label area) with the knob pinned to the LEFT of that block, which
                 leaves a big gap between the knob and the right edge of the row and forces
                 ugly per-character wrapping when the window narrows. Collapse the reserved
                 width to 0 and drop the labels so the knob sits flush at the right. -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
            <Style TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
