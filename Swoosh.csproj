<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;arm64;x64</Platforms>
    <AssemblyName>Swoosh</AssemblyName>
    <RootNamespace>Swoosh</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\swoosh.ico</ApplicationIcon>
    <Version>0.1.15</Version>
    <!-- WPF reads PerMonitorV2 from app.manifest; WinForms' WFAC010 nag is moot here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- The standalone WinUI 3 settings app lives in this subfolder of the repo root.
       Exclude it from the WPF app's default globbing so it builds as its own project. -->
  <ItemGroup>
    <Compile Remove="Swoosh.Settings\**" />
    <Page Remove="Swoosh.Settings\**" />
    <ApplicationDefinition Remove="Swoosh.Settings\**" />
    <None Remove="Swoosh.Settings\**" />
    <EmbeddedResource Remove="Swoosh.Settings\**" />
    <Content Remove="Swoosh.Settings\**" />
  </ItemGroup>

  <!-- The unit-test project is its own project too; keep its sources out of the app. -->
  <ItemGroup>
    <Compile Remove="Swoosh.Tests\**" />
    <Page Remove="Swoosh.Tests\**" />
    <None Remove="Swoosh.Tests\**" />
    <EmbeddedResource Remove="Swoosh.Tests\**" />
    <Content Remove="Swoosh.Tests\**" />
  </ItemGroup>

  <!-- Embed the app icon so the tray NotifyIcon can load it at runtime (the
       multi-resolution .ico lets Windows pick the right size for the tray). The
       same file is the Win32 ApplicationIcon, which gives Explorer / the download
       / the run dialog their icon. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\swoosh.ico" LogicalName="swoosh.ico" />
  </ItemGroup>

</Project>
